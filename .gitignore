# Editor cache and local engine state
.godot/
.summer/local/
demo/.godot/
**/__pycache__/
# Source fonts tools/cast_fonts.py downloads once
tools/.font-cache/
*.pyc
.DS_Store

# Build, staging and analysis outputs (tools/stage_hosted_export.sh, tools/build_*_game.py)
build/
analysis/
proof/

# Generated by tools/build_domain_graph.py (staging writes them into its disposable clone; a dev checkout may write them with --write)
demo/source-domains.json
demo/assets/shared_resources.json
demo/assets/client_resources.json
demo/assets/authority_resources.json
# UID owners the generator derives from importer metadata
demo/**/*.png.uid
demo/**/*.jpg.uid
demo/**/*.svg.uid
demo/**/*.wav.uid
demo/**/*.ogg.uid
demo/**/*.ttf.uid
demo/**/*.gltf.uid
demo/**/*.glb.uid

# Scratch
demo/*.bak

# Local stand-ins for art that is not committed (reference files for local testing only)
demo/**/_ref/
