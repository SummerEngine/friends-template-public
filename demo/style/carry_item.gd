extends RefCounted
## The carried item: `landscape` (a small landscape, the default) | `portrait` (a gilded wedding portrait) | `glass` (a large
## clear pane); all FLAT and carried like a tray (face up, no stand), the same size. The pane has a metal edge strip, rubber caps
## where the hands grip and the team's print on a frosted etched panel in the middle; a painting is a picture frame. Pure
## look: the pose, grips, network replication and break rule live in game/painting.gd, the break pieces in
## game/painting_shards.gd.
##
## An authored course picks the item per order and checkpoint (course_section.gd `carry_item_at`), so every peer derives the
## same item from the replicated course and checkpoint. Dev override (editor/dev run only, DevEnv): `--carry-item=glass|landscape|portrait`
## after the `--` of the engine command line, or FRIENDS_CARRY_ITEM.
##
## Data: `res://assets/paintings/painting_items.json`, generated by `tools/build_painting_items.py` (30 pieces per painting:
## frame 12, canvas 10, glass 8; 46 for the pane: 36 angular shards, strip 6, caps 4). The canvas faces sample
## `assets/paintings/painting_atlas.png` (vertex alpha 0 = picture); the pane's shards draw with style/glass_pane.gdshader and
## its etched print (etched_picture()). The intact item is the pieces at rest; the break lets the same pieces fly (painting_shards.gd).
const DevEnv := preload("res://dev_env.gd")
const TeamCast := preload("res://style/team_cast.gd")
const DATA_PATH := "res://assets/paintings/painting_items.json"
const PICTURE_PATH := "res" + "://assets/paintings/painting_atlas.png"
const TOON := "res://style/carry_item.gdshader"
const OUTLINE := "res://style/carry_item_outline.gdshader"
const GLASS := "res://style/painting_glaze.gdshader"
const REAL := "res://style/painting_real.gdshader"
const PANE := "res://style/glass_pane.gdshader"
const Surfaces := preload("res://style/surfaces.gd")
const DEFAULT := "landscape"
const ITEMS := ["landscape", "portrait", "glass"] ## the index travels in the shard state (painting_shards.gd)
static var _name := "__unset__"
static var _items := {}
static var _materials := {}
static var _glass_material: ShaderMaterial
static var _picture: Texture2D
static var _etched: Texture2D
const PANEL := Vector2(1.44, 0.72) ## metres along x across: the frosted panel of an opaque print (2:1, like print.png)
const ETCH_PANEL := Vector2(2.0, 1.0) ## an alpha etch fills more of the pane

## The active item name (always one of ITEMS).
static func active() -> String:
	if _name == "__unset__":
		var chosen := TeamCast.object_kind() # the team cast picks the painting
		var env := DevEnv.read("FRIENDS_CARRY_ITEM")
		if env != "": chosen = env
		for arg in DevEnv.user_args():
			if arg.begins_with("--carry-item="): chosen = arg.trim_prefix("--carry-item=")
		_name = chosen if chosen in ITEMS else DEFAULT
	return _name

## Switch the item at runtime (before the painting and shards are built, or on an order handover).
static func set_active(name: String) -> void:
	_name = name if name in ITEMS else DEFAULT

static func _data() -> Dictionary:
	if _items.is_empty():
		if not FileAccess.file_exists(DATA_PATH):
			push_error("Missing painting data: " + DATA_PATH)
			return {}
		var parsed = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
		if parsed is Dictionary: _items = parsed.get("items", {})
	return _items

## The dictionary of an item by name (pieces, palette, burst, flecks, sound_id, ...).
static func data(item_name: String) -> Dictionary:
	return _data().get(item_name, {})

## The active item's dictionary.
static func item() -> Dictionary:
	return data(active())

## Per-item sound id of the break (an entry of audio/sfx/mix.json "breaks").
static func break_sound_id() -> String:
	return str(item().get("sound_id", "break_painting"))

## Atlas rects of the two pictures (tools/make_painting_atlas.py LAYOUT; the canvas UVs are baked against them).
const PICTURE_RECTS := {"landscape": Rect2i(0, 0, 512, 211), "portrait": Rect2i(0, 212, 512, 192)}
const CANVAS := Color("fff4d2")

## The canvas atlas. With a team-cast picture (demo/cast/, TeamCast.picture()) both rects show that picture instead, so
## any image the creator drops in fits either painting: "contain" (TeamCast.picture_fit(), default) shows all of it on
## the cream canvas (logos), "cover" fills the rect and crops the centre (photos).
static func picture() -> Texture2D:
	if _picture == null:
		var base := load(PICTURE_PATH) as Texture2D
		_picture = base
		var cast := TeamCast.picture()
		if base != null and cast != null: _picture = cast_atlas(base.get_image(), cast.get_image(), TeamCast.picture_fit() == "cover")
	return _picture

static func cast_atlas(base: Image, cast: Image, cover: bool) -> Texture2D:
	var atlas := base.duplicate() as Image
	var source := cast.duplicate() as Image
	for image: Image in [atlas, source]:
		if image.is_compressed(): image.decompress()
		image.convert(Image.FORMAT_RGBA8) # a transparent logo sits on the canvas colour (blend_rect), not on black
	for rect: Rect2i in PICTURE_RECTS.values():
		var sx := float(rect.size.x) / source.get_width()
		var sy := float(rect.size.y) / source.get_height()
		var scale := maxf(sx, sy) if cover else minf(sx, sy) * 0.9 # contain leaves a cream margin inside the frame
		var fitted := source.duplicate() as Image
		fitted.resize(maxi(1, roundi(source.get_width() * scale)), maxi(1, roundi(source.get_height() * scale)), Image.INTERPOLATE_LANCZOS)
		var shown := Rect2i(maxi(0, (fitted.get_width() - rect.size.x) / 2), maxi(0, (fitted.get_height() - rect.size.y) / 2),
			mini(fitted.get_width(), rect.size.x), mini(fitted.get_height(), rect.size.y))
		atlas.fill_rect(rect, CANVAS)
		atlas.blend_rect(fitted, shown, rect.position + (rect.size - shown.size) / 2)
	atlas.convert(Image.FORMAT_RGB8)
	return ImageTexture.create_from_image(atlas)

## The material of the solid pieces (frame, canvas): toon + ink outline in the comic look, lacquer and a matte print in the
## facility look (painting_real.gdshader); one per painting is not needed: the atlas holds both pictures and the pieces carry
## their own UVs.
## The pane's etched print: the team-cast picture (TeamCast.picture()) contained in a 2:1 transparent image, the shape of the
## panel in the middle of the pane; null without a cast picture (a frosted panel with the fragile-glass mark). A picture with
## transparency is an etch (meta "alpha_etch"): its alpha is the frost, clear glass where it is transparent, white frost for
## a white etch, and it fills the bigger ETCH_PANEL. An opaque picture (a logo on a solid background, a photo) is printed whole,
## with a frosted margin, on a frosted PANEL.
static func etched_picture() -> Texture2D:
	if _etched == null:
		var cast := TeamCast.picture()
		if cast != null: _etched = etched(cast.get_image())
	return _etched

static func etched(cast: Image) -> Texture2D:
	var source := cast.duplicate() as Image
	if source.is_compressed(): source.decompress()
	var alpha := source.detect_alpha() != Image.ALPHA_NONE
	source.convert(Image.FORMAT_RGBA8)
	var size := Vector2i(1024, 512)
	var scale := minf(float(size.x) / source.get_width(), float(size.y) / source.get_height()) * (1.0 if alpha else 0.86) # a frosted margin round a print
	source.resize(maxi(1, roundi(source.get_width() * scale)), maxi(1, roundi(source.get_height() * scale)), Image.INTERPOLATE_LANCZOS)
	var sheet := Image.create_empty(size.x, size.y, false, Image.FORMAT_RGBA8)
	sheet.blit_rect(source, Rect2i(Vector2i.ZERO, source.get_size()), (size - source.get_size()) / 2)
	sheet.generate_mipmaps()
	var texture := ImageTexture.create_from_image(sheet)
	texture.set_meta("alpha_etch", alpha)
	return texture

## The pane and its shards (glass_pane.gdshader), the same in both looks.
static func pane_material() -> ShaderMaterial:
	if not _materials.has("pane"):
		var pane := ShaderMaterial.new()
		pane.shader = load(PANE)
		var art := etched_picture()
		var etch := art != null and bool(art.get_meta("alpha_etch", false))
		pane.set_shader_parameter("has_picture", art != null)
		pane.set_shader_parameter("alpha_etch", etch)
		pane.set_shader_parameter("panel_size", ETCH_PANEL if etch else PANEL)
		if art != null: pane.set_shader_parameter("picture", art)
		_materials["pane"] = pane
	return _materials["pane"]

static func material() -> ShaderMaterial:
	if not Surfaces.ink():
		if not _materials.has("real"):
			var lacquer := ShaderMaterial.new()
			lacquer.shader = load(REAL)
			lacquer.set_shader_parameter("picture", picture())
			_materials["real"] = lacquer
		return _materials["real"]
	if not _materials.has("solid"):
		var toon := ShaderMaterial.new()
		toon.shader = load(TOON)
		toon.set_shader_parameter("picture", picture())
		var outline := ShaderMaterial.new()
		outline.shader = load(OUTLINE)
		toon.next_pass = outline
		_materials["solid"] = toon
	return _materials["solid"]

## The thin glass sheet in front of the canvas (and its shards): translucent tint plus two white glare streaks in the comic look,
## clear glossy glass in the facility look.
static func glass_material() -> Material:
	if not Surfaces.ink():
		if not _materials.has("real_glass"):
			var pane := StandardMaterial3D.new()
			pane.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			pane.cull_mode = BaseMaterial3D.CULL_DISABLED
			pane.albedo_color = Color(0.92, 0.97, 1.0, 0.07)
			pane.roughness = 0.05
			pane.metallic_specular = 0.9
			_materials["real_glass"] = pane
		return _materials["real_glass"]
	if _glass_material == null:
		_glass_material = ShaderMaterial.new()
		_glass_material.shader = load(GLASS)
	return _glass_material

static func piece_material(spec: Dictionary) -> Material:
	match str(spec.get("kind", "solid")):
		"glass": return glass_material()
		"pane": return pane_material()
	return material()

static func _v(a: Array) -> Vector3: return Vector3(a[0], a[1], a[2])

## Vertex colour of every vertex of a piece, from the item palette (alpha 0 marks the picture texture).
static func _colors(entry: Dictionary, spec: Dictionary) -> PackedColorArray:
	var palette: Array = entry.palette
	var colors := PackedColorArray()
	for index in spec.colors:
		var c: Array = palette[int(index)]
		colors.append(Color(c[0], c[1], c[2], c[3] if c.size() > 3 else 1.0))
	return colors

## Mesh arrays of one piece with its positions mapped by `inverse` (the piece's own frame removed).
## TANGENT carries the smooth normal (shared corners averaged) so the outline hull does not tear
## along the flat-shaded edges.
static func piece_arrays(entry: Dictionary, spec: Dictionary, inverse: Transform3D) -> Array:
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var smooth := {}
	for i in spec.positions.size():
		var point := _v(spec.positions[i])
		var normal := _v(spec.normals[i]).normalized()
		vertices.append(inverse * point)
		normals.append((inverse.basis * normal).normalized())
		var key := Vector3i((point * 1000.0).round())
		smooth[key] = smooth.get(key, Vector3.ZERO) + normal
	var tangents := PackedFloat32Array()
	for i in spec.positions.size():
		var s: Vector3 = (inverse.basis * (smooth[Vector3i((_v(spec.positions[i]) * 1000.0).round())] as Vector3)).normalized()
		tangents.append_array([s.x, s.y, s.z, 1.0])
	var uvs := PackedVector2Array()
	var spec_uvs: Array = spec.get("uvs", [])
	for i in spec.positions.size(): uvs.append(Vector2(spec_uvs[i][0], spec_uvs[i][1]) if i < spec_uvs.size() else Vector2.ZERO)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_TANGENT] = tangents
	arrays[Mesh.ARRAY_COLOR] = _colors(entry, spec)
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_INDEX] = PackedInt32Array(spec.indices)
	return arrays

static func _merge(entry: Dictionary, kind: String) -> Array:
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var tangents := PackedFloat32Array()
	var colors := PackedColorArray()
	var uvs := PackedVector2Array()
	var indices := PackedInt32Array()
	for spec: Dictionary in entry.pieces:
		if str(spec.get("kind", "solid")) != kind: continue
		var arrays := piece_arrays(entry, spec, Transform3D.IDENTITY)
		var base := vertices.size()
		vertices.append_array(arrays[Mesh.ARRAY_VERTEX])
		normals.append_array(arrays[Mesh.ARRAY_NORMAL])
		tangents.append_array(arrays[Mesh.ARRAY_TANGENT])
		colors.append_array(arrays[Mesh.ARRAY_COLOR])
		uvs.append_array(arrays[Mesh.ARRAY_TEX_UV])
		var piece_colors: PackedColorArray = arrays[Mesh.ARRAY_COLOR]
		var piece_indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		for t in range(0, piece_indices.size(), 3):
			# the whole pane shows no cracks: its shards' cut edges (vertex alpha 0.5) only draw once it breaks
			if kind == "pane" and piece_colors[piece_indices[t]].a < 0.75: continue
			for k in 3: indices.append(base + piece_indices[t + k])
	var merged := []
	merged.resize(Mesh.ARRAY_MAX)
	merged[Mesh.ARRAY_VERTEX] = vertices
	merged[Mesh.ARRAY_NORMAL] = normals
	merged[Mesh.ARRAY_TANGENT] = tangents
	merged[Mesh.ARRAY_COLOR] = colors
	merged[Mesh.ARRAY_TEX_UV] = uvs
	merged[Mesh.ARRAY_INDEX] = indices
	return merged

## The intact item: the pieces merged at rest into one mesh, one surface per piece kind it has (solid first, then the
## see-through glass or pane), in the item frame (x across, y up, z along the carry axis), origin at the item's centre.
static func build_intact() -> MeshInstance3D:
	var entry := item()
	var mesh := ArrayMesh.new()
	var vertices := 0
	for kind in ["solid", "glass", "pane"]:
		var arrays := _merge(entry, kind)
		var count := (arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()
		if count == 0: continue
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		mesh.surface_set_material(mesh.get_surface_count() - 1, piece_material({"kind": kind}))
		vertices += count
	var visual := MeshInstance3D.new()
	visual.name = "CarryItem_" + active()
	visual.mesh = mesh
	print("GW_PAINTING intact item=", active(), " pieces=", entry.pieces.size(), " vertices=", vertices)
	return visual

## ---- Break flecks: torn canvas scraps and paint flecks in the painting's colours (glass splinters for the pane), plus glass glints. Two
## MultiMeshes whose instances are a pure function of the break age (ballistic with air drag, tumbling in flight, flat on
## the floor once down, glints twinkling), so authority-less replicas and late joiners draw the same thing from the
## replicated age alone. The anchors are the 30 piece positions when the break first draws.
const FLECK_GRAVITY := 7.0
const FLECK_DRAG := 1.6
const FLECK_LIFT := 0.035 # the physics floor of the course sits a few cm under its visual road

static var _fleck_material: StandardMaterial3D
static var _scrap_mesh: ArrayMesh
static var _star_mesh: ArrayMesh

static func _flat_mesh(points: Array[Vector2], indices: Array[int]) -> ArrayMesh:
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	for point in points:
		vertices.append(Vector3(point.x, 0.0, point.y))
		normals.append(Vector3.UP)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_INDEX] = PackedInt32Array(indices)
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	mesh.surface_set_material(0, _flecks_material())
	return mesh

static func _flecks_material() -> StandardMaterial3D:
	if _fleck_material == null:
		_fleck_material = StandardMaterial3D.new()
		_fleck_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_fleck_material.vertex_color_use_as_albedo = true
		_fleck_material.vertex_color_is_srgb = true
		_fleck_material.cull_mode = BaseMaterial3D.CULL_DISABLED
		_fleck_material.disable_receive_shadows = true
	return _fleck_material

static func _scrap() -> ArrayMesh:
	if _scrap_mesh == null:
		_scrap_mesh = _flat_mesh([Vector2(-0.5, -0.32), Vector2(0.5, -0.42), Vector2(0.28, 0.4), Vector2(-0.46, 0.3)], [0, 1, 2, 0, 2, 3])
	return _scrap_mesh

static func _star() -> ArrayMesh:
	if _star_mesh == null:
		var points: Array[Vector2] = [Vector2.ZERO]
		var indices: Array[int] = []
		for i in 8:
			var a := TAU * float(i) / 8.0
			var r := 0.62 if i % 2 == 0 else 0.13
			points.append(Vector2(cos(a), sin(a)) * r)
		for i in 8: indices.append_array([0, 1 + i, 1 + (i + 1) % 8])
		_star_mesh = _flat_mesh(points, indices)
	return _star_mesh

static func _fleck_group(parent: Node3D, group_name: String, mesh: Mesh, count: int) -> MultiMeshInstance3D:
	var multi := MultiMesh.new()
	multi.transform_format = MultiMesh.TRANSFORM_3D
	multi.use_colors = true
	multi.mesh = mesh
	multi.instance_count = count
	var holder := MultiMeshInstance3D.new()
	holder.name = group_name
	holder.multimesh = multi
	holder.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	holder.custom_aabb = AABB(Vector3(-12, -12, -12), Vector3(24, 24, 24))
	parent.add_child(holder)
	return holder

## `anchors`: world positions of the pieces; `centre`: their mean; `item_name`: the painting that broke ("" = the active one).
## Returns null when the item has no flecks.
static func build_flecks(seed_value: int, anchors: Array, centre: Vector3, item_name := "") -> Node3D:
	var spec: Dictionary = (item() if item_name == "" else data(item_name)).get("flecks", {})
	if spec.is_empty() or anchors.is_empty(): return null
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var root := Node3D.new()
	root.name = "BreakFlecks"
	root.position = centre
	var palette: Array = spec.colors
	var particles := {"scraps": [], "glints": []}
	for kind in ["scraps", "glints"]:
		var count := int(spec.count) if kind == "scraps" else int(spec.glints)
		var holder := _fleck_group(root, kind, _scrap() if kind == "scraps" else _star(), count)
		for i in count:
			var anchor: Vector3 = anchors[rng.randi() % anchors.size()] - centre
			var away := Vector3(anchor.x, 0.0, anchor.z)
			away = away.normalized() if away.length() > 0.05 else Vector3.RIGHT.rotated(Vector3.UP, rng.randf() * TAU)
			away = away.rotated(Vector3.UP, rng.randf_range(-0.7, 0.7))
			var big := rng.randf() < 0.3
			var size := rng.randf_range(0.13, 0.22) if (kind == "scraps" and big) else (rng.randf_range(0.06, 0.11) if kind == "scraps" else rng.randf_range(0.11, 0.2))
			var color := Color(palette[rng.randi() % palette.size()]) if kind == "scraps" else Color(1.0, 1.0, 1.0)
			if kind == "scraps": color = color.lightened(rng.randf_range(-0.1, 0.12))
			holder.multimesh.set_instance_color(i, color)
			particles[kind].append({
				"p0": anchor + Vector3(rng.randf_range(-0.1, 0.1), rng.randf_range(0.0, 0.15), rng.randf_range(-0.1, 0.1)),
				"v": away * rng.randf_range(0.7, 2.7) + Vector3.UP * rng.randf_range(1.6, 4.2),
				"size": size,
				"axis": Vector3(rng.randf_range(-1, 1), rng.randf_range(-1, 1), rng.randf_range(-1, 1)).normalized(),
				"rate": rng.randf_range(-9.0, 9.0),
				"yaw": rng.randf() * TAU,
				"phase": rng.randf() * TAU,
			})
	root.set_meta("particles", particles)
	return root

## Place every fleck for the break age: `floor_y` is the world floor under the pieces, the flecks vanish (shrink)
## between `fade_start` and `fade_end`.
static func animate_flecks(root: Node3D, age: float, floor_y: float, fade_start: float, fade_end: float) -> void:
	var particles: Dictionary = root.get_meta("particles")
	var shrink := 1.0 - smoothstep(fade_start, fade_end, age)
	var floor_local := floor_y + FLECK_LIFT - root.position.y
	var drag_gain := (1.0 - exp(-FLECK_DRAG * age)) / FLECK_DRAG
	for kind: String in particles:
		var multi: MultiMesh = (root.get_node(kind) as MultiMeshInstance3D).multimesh
		var list: Array = particles[kind]
		for i in list.size():
			var fleck: Dictionary = list[i]
			var p0: Vector3 = fleck.p0
			var v: Vector3 = fleck.v
			var y: float = p0.y + (v.y + FLECK_GRAVITY / FLECK_DRAG) * drag_gain - FLECK_GRAVITY * age / FLECK_DRAG
			var down := y <= floor_local
			var at := Vector3(p0.x + v.x * drag_gain, maxf(y, floor_local), p0.z + v.z * drag_gain)
			var basis := Basis(Vector3.UP, float(fleck.yaw)) if down else Basis(fleck.axis, float(fleck.rate) * age + float(fleck.phase))
			var size: float = float(fleck.size) * shrink * smoothstep(0.0, 0.06, age)
			if kind == "glints": size *= 0.35 + 0.65 * pow(0.5 + 0.5 * sin(age * 9.0 + float(fleck.phase)), 2.0)
			multi.set_instance_transform(i, Transform3D(basis.scaled(Vector3.ONE * size), at))
